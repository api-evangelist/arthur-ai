{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arthur Scope Agents V1 Connector Schemas V1 API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Connector Schemas V1",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Available Connector Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/connector_schemas/connector_types",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://platform-auth.arthur.ai/realms/arthur/protocol/openid-connect/auth",
              "accessTokenUrl": "https://platform-auth.arthur.ai/realms/arthur/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns all Arthur-supported connector types."
        },
        {
          "info": {
            "name": "Get Connector Schema By Type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/connector_schemas/:connector_type",
            "params": [
              {
                "name": "connector_type",
                "value": "",
                "type": "path",
                "description": "The type of the connector schema to fetch."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://platform-auth.arthur.ai/realms/arthur/protocol/openid-connect/auth",
              "accessTokenUrl": "https://platform-auth.arthur.ai/realms/arthur/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns a connector schema by type."
        }
      ]
    }
  ],
  "bundled": true
}